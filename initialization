from machine import Pin
class LED:
    ##creating a LED class to control the LED from the GPIO pins
    def __init__(self, pin, name="LED"):
        self.pin = Pin(pin, Pin.OUT)
        self.name = name
    ##defining on and off for the LED
    def on(self):
        self.pin.value(1)

    def off(self):
        self.pin.value(0)

class button:
    def __init__(self, pin, name, action):
        self.pin = Pin(pin, Pin.IN, Pin.PULL_UP)
        self.name = name
        self.action = action
    ##defining what clicking the button causes
    def click(self):
        print(f"Car Startup initiated")
        if self.pin.value() == 1:  # Button is pressed
            self.action()

start_button = button(pin=0, name="Start Button", action=lambda: print("Car Startup initiated"))
led1 = LED(pin=1, name="LED1")
##define the action of the button when pressed
if start_button.click():
    led1.on()
